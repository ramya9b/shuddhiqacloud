rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User preferences document — each user can only read/write their own
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Shareable TC links — public read, authenticated create only (v9.53 — security hardening)
    match /shares/{shareId} {
      allow read: if true;                              // public read-only (by design)
      allow create: if request.auth != null             // must be signed in
                    && request.resource.data.markdown is string
                    && request.resource.data.markdown.size() < 500000  // 500KB max
                    && request.resource.data.keys().hasOnly(['markdown', 'createdAt', 'platform', 'version']);
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.get('uid', null);
    }

    // Block all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
