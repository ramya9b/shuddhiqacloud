rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User preferences document — each user can only read/write their own
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Shared data (future use — shareable TC links)
    // match /shares/{shareId} {
    //   allow read: if true;                            // public read-only
    //   allow write: if request.auth != null;           // must be signed in to create
    // }

    // Block all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
