rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User preferences document — each user can only read/write their own
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Shareable TC links — public read, any user can create (v9.52)
    match /shares/{shareId} {
      allow read: if true;                              // public read-only
      allow create: if request.resource.data.markdown is string
                    && request.resource.data.markdown.size() < 500000; // 500KB max
      allow update, delete: if request.auth != null;   // only authenticated can modify
    }

    // Block all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
