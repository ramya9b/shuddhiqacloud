# Cloudflare Pages _headers — v6.2 performance
# https://developers.cloudflare.com/pages/configuration/headers/

# ── HTML: short cache, must-revalidate (app updates frequently)
/app
  Cache-Control: public, max-age=300, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# ── HTML fallback
/app.html
  Cache-Control: public, max-age=300, must-revalidate

# ── Privacy policy: short cache
/privacy
  Cache-Control: public, max-age=3600, must-revalidate
  X-Content-Type-Options: nosniff

/privacy.html
  Cache-Control: public, max-age=3600, must-revalidate

# ── Service worker: never cache (must always be fresh)
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

# ── Manifest: short cache
/manifest.json
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json

# ── Icons: long cache (content never changes)
/icons/*
  Cache-Control: public, max-age=31536000, immutable

# ── API routes: no cache (live data)
/api/*
  Cache-Control: no-store
  Access-Control-Allow-Origin: *

/functions/api/*
  Cache-Control: no-store

# ── Security headers for all routes — v9.20 (TC011-OBS-03)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.anthropic.com https://api.groq.com https://generativelanguage.googleapis.com https://api.exchangerate-api.com https://cloudbilling.googleapis.com https://openidconnect.googleapis.com https://oauth2.googleapis.com; frame-ancestors 'none'

# ── Sitemap ──
/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml
